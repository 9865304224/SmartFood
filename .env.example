# Admin Credentials
ADMIN_EMAIL=admin@smartfood.com
ADMIN_PASSWORD=Admin@123

# SmartFood Environment Configuration Example
PORT=8080
MONGODB_URI=mongodb://localhost:27017/smartfood_db
JWT_SECRET=smartfood_super_secure_jwt_secret_key_which_is_at_least_256_bits_long_for_hmac_sha256
JWT_EXPIRATION_MS=86400000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# Mail Configuration (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Payment Gateway Configuration
PAYMENT_MODE=MOCK
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_mock_secret

# AI Service Configuration (GEMINI or OPENAI or DETERMINISTIC_FALLBACK)
AI_MODE=GEMINI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_API_KEY=

# Firebase Cloud Messaging
FCM_ENABLED=false
FCM_KEY_PATH=

# Routing & Algorithmic Parameters
MAX_EXTRA_DELAY_MINUTES=15
MAX_GROUP_DISTANCE_KM=3.5

# Maps & Geocoding
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODING_API_URL=https://nominatim.openstreetmap.org
ROUTING_API_URL=https://router.project-osrm.org
